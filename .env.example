# Required application settings must be set, even when empty (e.g. API_KEY_HASHES= locally).
# Required: APP_ENV, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, API_KEY_HASHES, CORS_ALLOW_ORIGIN.
# PHP application mode: local|test|production. APP_ENV must be set at startup.
# local/test skip production safety checks; production enables strict startup checks.
APP_ENV=local
# Boolean: 0|1 (also true/false, yes/no, on/off). local/test may enable diagnostics.
# production always hides diagnostics and rejects an enabled APP_DEBUG at startup.
APP_DEBUG=1
# Host HTTP port: integer 1..65535, in both local and production.
APP_PORT=8082
# IANA timezone used by PHP and containers, e.g. UTC or Europe/Bratislava.
TZ=UTC
# MySQL hostname/service name. db works inside this Compose network in both modes.
DB_HOST=db
# MySQL TCP port inside the network: integer 1..65535; not the development host port.
DB_PORT=3306
# MySQL database name. Set when initializing a new data volume.
DB_NAME=app
# MySQL application user. Set when initializing a new data volume.
DB_USER=app
# Application password. Local example only; production rejects empty/example passwords.
DB_PASSWORD=change-me
# MySQL root password. Local example only; production rejects empty/example passwords.
DB_ROOT_PASSWORD=change-me-too
# Comma-separated client:sha256hex entries from bin/console apikey:generate <client>.
# Client: 1-64 ASCII letters/digits/_/-, starting with a letter/digit; hash: 64 hex characters.
# Repeat a client with multiple hashes for rotation. Empty/malformed denies all keys
# in local/test and prevents production startup; bare hashes are not accepted.
API_KEY_HASHES=
# One CORS origin, e.g. https://client.example; * is allowed only in local/test.
# production requires an explicit origin instead of the wildcard.
CORS_ALLOW_ORIGIN=*
# Compose resource prefix: lowercase letters/digits, hyphens/underscores; start with a letter/digit.
# Use distinct project names for independent local/production stacks.
COMPOSE_PROJECT_NAME=docker_framework_api

# Development override only: MySQL host port 1..65535, bound to 127.0.0.1.
# Base compose.yaml does not publish the database port in production.
DB_HOST_PORT=33306
# Nginx server_name, e.g. localhost or api.example.com; used in both modes.
# Despite the name, the FastCGI backend is always php:9000, not this value.
NGINX_BACKEND_DOMAIN=localhost
