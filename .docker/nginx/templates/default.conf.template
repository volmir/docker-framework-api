server {
    listen 80;
    server_name ${NGINX_BACKEND_DOMAIN};
    root /var/www/app/public;

    add_header X-Content-Type-Options nosniff always;
    add_header Access-Control-Allow-Origin "${CORS_ALLOW_ORIGIN}" always;
    add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type,Authorization,X-Api-Key,X-Request-Id" always;
    add_header Access-Control-Max-Age 86400 always;

    error_page 404 = @not_found;
    error_page 413 = @body_too_large;
    error_page 429 = @rate_limited;
    error_page 500 = @internal_error;
    error_page 502 = @bad_gateway;
    error_page 503 = @service_unavailable;
    error_page 504 = @gateway_timeout;

    location = /nginx-health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        internal;
        if ($request_method = OPTIONS) {
            return 204;
        }
        limit_req zone=api burst=20 nodelay;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass php:9000;
    }

    location @rate_limited {
        default_type application/json;
        return 429 '{"error":{"code":"TOO_MANY_REQUESTS","message":"Too many requests","details":{}}}';
    }

    location @not_found {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Not found","details":{}}}';
    }

    location @body_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"Request body too large","details":{}}}';
    }

    location @internal_error {
        default_type application/json;
        return 500 '{"error":{"code":"internal_error","message":"Internal Server Error","details":{}}}';
    }

    location @bad_gateway {
        default_type application/json;
        return 502 '{"error":{"code":"bad_gateway","message":"Bad Gateway","details":{}}}';
    }

    location @service_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"service_unavailable","message":"Service Unavailable","details":{}}}';
    }

    location @gateway_timeout {
        default_type application/json;
        return 504 '{"error":{"code":"gateway_timeout","message":"Gateway Timeout","details":{}}}';
    }

    location ~ \.php(?:/|$) {
        return 404;
    }
}
