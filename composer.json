{
    "name": "volmir/docker-framework-api",
    "description": "Minimal PHP 8.4 API with PDO, running in Docker without runtime Composer packages",
    "homepage": "https://github.com/volmir/docker-framework-api",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.3"
    },
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src bin public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --memory-limit=256M"
    }
}
